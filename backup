#!/bin/bash

SOURCE="/opt/app"
BACKUP_DIR="/backup"
DATE=$(date +%F)
BACKUP_FILE="$BACKUP_DIR/app_backup_$DATE.tar.gz"

tar -czf "$BACKUP_FILE" "$SOURCE"

if [ $? -eq 0 ]
then
    echo "Backup successful: $BACKUP_FILE"
else
    echo "Backup failed"
    exit 1
fi

find "$BACKUP_DIR" -type f -name "*.tar.gz" -mtime +7 -delete

echo "Old backups cleaned"
